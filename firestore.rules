rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 앱이 사용하는 경로만 인증(익명 포함) 사용자에게 허용하고, 그 외 전 경로 차단.
    // 완전한 외부 차단은 익명 인증 특성상 규칙만으로 불가 — App Check 활성화 필요(콘솔 작업).
    match /artifacts/default-app-id/public/data/meat_wms_config/master_data {
      allow read, create, update: if request.auth != null;
      allow delete: if false; // 설정 문서는 어떤 경우에도 삭제 금지
    }
    match /artifacts/default-app-id/public/data/meat_wms_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    match /artifacts/default-app-id/public/data/meat_production_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
